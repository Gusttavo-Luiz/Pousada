# ---------------------------------------------------------------
# Luar de Minas Suítes — variáveis de build (opcionais)
# Os dados da hospedagem ficam em src/config/site.ts.
# ---------------------------------------------------------------

# true = mostra conteúdo ainda não confirmado (categorias de suíte
# "a confirmar", nomes dos arquivos de fotos). Padrão: só em `npm run dev`.
PUBLIC_SHOW_PENDING=

# true = versão de demonstração: formulário não envia nada e a página
# não é indexada pelos buscadores.
PUBLIC_DEMO_MODE=
