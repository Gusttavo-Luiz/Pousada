---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../config/site';
import { demoMode } from '../config/flags';

/**
 * Canal usado ao enviar a consulta, em ordem de prioridade:
 * motor de reservas oficial → WhatsApp oficial → e-mail oficial.
 * Sem nenhum configurado, o formulário valida e orienta o visitante, sem
 * simular envio, disponibilidade ou preço.
 */
const channel = demoMode
  ? 'demo'
  : site.bookingEngineUrl
    ? 'engine'
    : site.contact.whatsapp
      ? 'whatsapp'
      : site.contact.email
        ? 'email'
        : 'none';

const config = {
  channel,
  name: site.name,
  engine: site.bookingEngineUrl,
  whatsapp: whatsappLink(),
  email: site.contact.email,
  limits: site.bookingLimits,
};

const submitHint = {
  demo: 'Versão de demonstração: os dados são apenas validados.',
  engine: 'Você será direcionado ao sistema de reservas oficial.',
  whatsapp: 'Sua consulta será enviada pelo WhatsApp oficial da hospedagem.',
  email: 'Sua consulta será preparada no seu aplicativo de e-mail.',
  none: 'A disponibilidade é confirmada diretamente pela equipe.',
}[channel];

const counters = [
  { name: 'adults', label: 'Adultos', min: 1, max: site.bookingLimits.maxAdults, value: 2 },
  { name: 'children', label: 'Crianças', min: 0, max: site.bookingLimits.maxChildren, value: 0 },
  { name: 'rooms', label: 'Quartos', min: 1, max: site.bookingLimits.maxRooms, value: 1 },
] as const;
---

<section class="booking section on-dark" id="reservas" aria-labelledby="booking-title">
  <div class="container booking__grid">
    <div class="booking__intro">
      <p class="eyebrow" data-reveal>Reserva direta</p>
      <h2 class="display booking__title" id="booking-title" data-reveal style="--reveal-delay:100">
        Sua próxima viagem <em>começa aqui.</em>
      </h2>
      <p class="lead booking__lead" data-reveal style="--reveal-delay:180">
        Escolha suas datas, consulte as opções disponíveis e planeje sua estadia no Luar de Minas Suítes.
      </p>
      <ul class="booking__points" data-reveal style="--reveal-delay:240">
        <li><Icon name="heart" size={20} /> Atendimento direto com a equipe da hospedagem</li>
        <li><Icon name="calendar" size={20} /> Disponibilidade e valores confirmados para as suas datas</li>
        <li><Icon name="key" size={20} /> Nenhum pagamento é solicitado neste site</li>
      </ul>
    </div>

    <form
      class="booking-form"
      data-booking-form
      data-config={JSON.stringify(config)}
      novalidate
      aria-describedby="booking-hint"
      data-reveal
      style="--reveal-delay:160"
    >
      <h3 class="booking-form__title">Consultar disponibilidade</h3>

      <div class="booking-form__interest" data-interest hidden>
        <span>Interesse: <strong data-interest-name></strong></span>
        <button type="button" data-interest-clear aria-label="Remover acomodação de interesse">
          <Icon name="close" size={16} />
        </button>
        <input type="hidden" name="interest" value="" />
      </div>

      <div class="booking-form__dates">
        <div class="field">
          <label for="checkin">Check-in</label>
          <input id="checkin" name="checkin" type="date" required aria-describedby="checkin-error" />
          <p class="field__error" id="checkin-error" data-error-for="checkin"></p>
        </div>
        <div class="field">
          <label for="checkout">Check-out</label>
          <input id="checkout" name="checkout" type="date" required aria-describedby="checkout-error" />
          <p class="field__error" id="checkout-error" data-error-for="checkout"></p>
        </div>
      </div>

      <div class="booking-form__counters">
        {
          counters.map((c) => (
            <div class="field counter" data-counter>
              <label for={c.name}>
                {c.label}
              </label>
              <div class="counter__control">
                <button type="button" data-step="-1" aria-label={`Diminuir ${c.label.toLowerCase()}`} aria-controls={c.name}>
                  <Icon name="minus" size={18} />
                </button>
                <input
                  id={c.name}
                  name={c.name}
                  type="number"
                  inputmode="numeric"
                  min={c.min}
                  max={c.max}
                  value={c.value}
                  required
                  aria-describedby={`${c.name}-error`}
                />
                <button type="button" data-step="1" aria-label={`Aumentar ${c.label.toLowerCase()}`} aria-controls={c.name}>
                  <Icon name="plus" size={18} />
                </button>
              </div>
              <p class="field__error" id={`${c.name}-error`} data-error-for={c.name} />
            </div>
          ))
        }
      </div>

      <p class="booking-form__nights" data-nights aria-live="polite"></p>

      <button class="btn btn--gold btn--block booking-form__submit" type="submit">
        Consultar disponibilidade <Icon name="arrowRight" class="icon--move" />
      </button>
      <p class="booking-form__hint" id="booking-hint">{submitHint}</p>

      <div class="booking-form__status" data-status role="status" aria-live="polite" tabindex="-1" hidden></div>
    </form>
  </div>
</section>

<style>
  .booking {
    position: relative;
    overflow: hidden;
    background: var(--forest-night);
    color: var(--warm-white);
  }

  .booking::before {
    content: '';
    position: absolute;
    inset: auto -10% -40% 30%;
    height: 80%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(183 154 105 / 0.14), transparent);
    pointer-events: none;
  }

  .booking__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 1.5rem + 5vw, 7rem);
    align-items: center;
  }

  .booking__title {
    margin-top: 1.25rem;
  }

  .booking__title em {
    font-style: italic;
    color: var(--gold-light);
  }

  .booking__lead {
    max-width: 30rem;
    margin-top: 1.5rem;
  }

  .booking__points {
    display: grid;
    gap: 0.9rem;
    margin-top: 2.25rem;
    font-size: 0.9375rem;
    color: var(--on-dark-soft);
  }

  .booking__points li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .booking__points :global(.icon) {
    flex: none;
    color: var(--gold-light);
  }

  .booking-form {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
    border-radius: var(--radius-lg);
    background: var(--warm-white);
    color: var(--ink);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.5);
  }

  .booking-form__title {
    font-size: var(--step-2);
    color: var(--forest);
  }

  .booking-form__interest {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.6rem 0.55rem 1rem;
    border-radius: 999px;
    background: var(--beige);
    font-size: 0.875rem;
  }

  .booking-form__interest[hidden] {
    display: none;
  }

  .booking-form__interest button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }

  .booking-form__dates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .booking-form__counters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .field label {
    display: grid;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--forest);
  }

  .field input {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: #fff;
    font-size: 1rem;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .field input:hover {
    border-color: var(--olive);
  }

  .field input:focus {
    outline: none;
    border-color: var(--forest);
    box-shadow: 0 0 0 3px rgb(38 61 50 / 0.15);
  }

  .field input[aria-invalid='true'] {
    border-color: #a3402c;
    box-shadow: 0 0 0 3px rgb(163 64 44 / 0.12);
  }

  .field__error {
    min-height: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #a3402c;
  }

  .field__error:empty {
    display: none;
  }

  .counter__control {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem;
    align-items: center;
    min-height: 3.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: #fff;
  }

  .counter__control:focus-within {
    border-color: var(--forest);
    box-shadow: 0 0 0 3px rgb(38 61 50 / 0.15);
  }

  .counter__control input {
    min-height: 0;
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    text-align: center;
    font-weight: 600;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .counter__control input:focus {
    box-shadow: none;
  }

  .counter__control input::-webkit-inner-spin-button,
  .counter__control input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .counter__control button {
    display: grid;
    place-items: center;
    height: 100%;
    border: 0;
    background: transparent;
    color: var(--forest);
  }

  .counter__control button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .booking-form__nights {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .booking-form__nights:empty {
    display: none;
  }

  .booking-form__submit {
    margin-top: 0.25rem;
  }

  .booking-form__hint {
    margin-top: -0.5rem;
    font-size: 0.8125rem;
    text-align: center;
    color: var(--ink-soft);
  }

  .booking-form__status {
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--beige);
    font-size: 0.9375rem;
  }

  .booking-form__status:focus {
    outline: none;
  }

  .booking-form__status[data-tone='error'] {
    background: #f7e6e1;
    color: #7d2f1f;
  }

  .booking-form__status :global(strong) {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--forest);
  }

  .booking-form__status :global(ul) {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .booking-form__status :global(a) {
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .booking__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .booking-form__dates,
    .booking-form__counters {
      grid-template-columns: 1fr;
    }

    .counter {
      grid-template-columns: 1fr minmax(9rem, 0.9fr);
      align-items: center;
    }

    .counter .field__error {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import {
    addDays,
    bookingEngineUrl,
    bookingMessage,
    bookingSummary,
    nightsBetween,
    toISODate,
    validateBooking,
    type BookingErrors,
    type BookingLimits,
    type BookingRequest,
  } from '../lib/booking';

  interface Config {
    channel: 'demo' | 'engine' | 'whatsapp' | 'email' | 'none';
    name: string;
    engine: string;
    whatsapp: string;
    email: string;
    limits: BookingLimits;
  }

  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');

  if (form) {
    const config = JSON.parse(form.dataset.config!) as Config;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const checkin = field('checkin');
    const checkout = field('checkout');
    const interest = field('interest');
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const nights = form.querySelector<HTMLElement>('[data-nights]')!;
    const interestBox = form.querySelector<HTMLElement>('[data-interest]')!;
    const interestName = form.querySelector<HTMLElement>('[data-interest-name]')!;
    const today = () => toISODate(new Date());

    checkin.min = today();
    checkout.min = addDays(today(), 1);

    const read = (): BookingRequest => ({
      checkin: checkin.value,
      checkout: checkout.value,
      adults: Number(field('adults').value),
      children: Number(field('children').value),
      rooms: Number(field('rooms').value),
      interest: interest.value || undefined,
    });

    const showErrors = (errors: BookingErrors) => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        const name = el.dataset.errorFor as keyof BookingErrors;
        el.textContent = errors[name] ?? '';
        field(name).setAttribute('aria-invalid', String(Boolean(errors[name])));
      });
    };

    const updateNights = () => {
      const { checkin: a, checkout: b } = read();
      const n = a && b ? nightsBetween(a, b) : 0;
      nights.textContent = n > 0 ? `${n} ${n === 1 ? 'noite' : 'noites'} de estadia` : '';
    };

    const setStatus = (html: string, tone: 'info' | 'error' = 'info') => {
      status.innerHTML = html;
      status.dataset.tone = tone;
      status.hidden = false;
      status.focus({ preventScroll: true });
      status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };

    const escape = (text: string) =>
      text.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    const summaryList = (req: BookingRequest) =>
      `<ul>${bookingSummary(req)
        .map((line) => `<li>${escape(line)}</li>`)
        .join('')}</ul>`;

    // Datas: o check-out acompanha o check-in.
    checkin.addEventListener('change', () => {
      if (checkin.value) {
        const minOut = addDays(checkin.value, 1);
        checkout.min = minOut;
        if (!checkout.value || checkout.value <= checkin.value) checkout.value = minOut;
      }
      updateNights();
      if (form.dataset.touched) showErrors(validateBooking(read(), config.limits, today()));
    });
    checkout.addEventListener('change', () => {
      updateNights();
      if (form.dataset.touched) showErrors(validateBooking(read(), config.limits, today()));
    });

    // Contadores (+/−).
    form.querySelectorAll<HTMLElement>('[data-counter]').forEach((counter) => {
      const input = counter.querySelector('input')!;
      const [minus, plus] = counter.querySelectorAll<HTMLButtonElement>('[data-step]');
      const sync = () => {
        const value = Number(input.value);
        minus.disabled = value <= Number(input.min);
        plus.disabled = value >= Number(input.max);
      };
      counter.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const next = Number(input.value || 0) + Number(btn.dataset.step);
          input.value = String(Math.min(Number(input.max), Math.max(Number(input.min), next)));
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }),
      );
      input.addEventListener('input', () => {
        sync();
        if (form.dataset.touched) showErrors(validateBooking(read(), config.limits, today()));
      });
      sync();
    });

    // Acomodação de interesse (botões dos cards).
    const setInterest = (name: string) => {
      interest.value = name;
      interestName.textContent = name;
      interestBox.hidden = !name;
    };
    document.querySelectorAll<HTMLAnchorElement>('[data-room-interest]').forEach((link) =>
      link.addEventListener('click', () => setInterest(link.dataset.roomInterest ?? '')),
    );
    form.querySelector('[data-interest-clear]')!.addEventListener('click', () => setInterest(''));

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      form.dataset.touched = 'true';
      const req = read();
      const errors = validateBooking(req, config.limits, today());
      showErrors(errors);

      const firstInvalid = Object.keys(errors)[0];
      if (firstInvalid) {
        status.hidden = true;
        field(firstInvalid).focus();
        return;
      }

      const message = bookingMessage(req, config.name);

      switch (config.channel) {
        case 'engine': {
          setStatus('<strong>Tudo certo!</strong>Abrindo o sistema de reservas oficial…');
          window.location.assign(bookingEngineUrl(config.engine, req));
          break;
        }
        case 'whatsapp': {
          const url = `${config.whatsapp}?text=${encodeURIComponent(message)}`;
          window.open(url, '_blank', 'noopener');
          setStatus(
            `<strong>Consulta pronta para envio</strong>Envie a mensagem no WhatsApp oficial para que a equipe confirme a disponibilidade. Se a conversa não abriu, <a href="${escape(url)}" target="_blank" rel="noopener">abra o WhatsApp por aqui</a>.${summaryList(req)}`,
          );
          break;
        }
        case 'email': {
          const url = `mailto:${config.email}?subject=${encodeURIComponent(`Consulta de disponibilidade — ${config.name}`)}&body=${encodeURIComponent(message)}`;
          setStatus(
            `<strong>Consulta pronta para envio</strong>Abrimos seu aplicativo de e-mail com os dados preenchidos. Envie a mensagem para que a equipe confirme a disponibilidade. Se nada abrir, escreva para <a href="${escape(url)}">${escape(config.email)}</a>.${summaryList(req)}`,
          );
          window.location.href = url;
          break;
        }
        case 'demo': {
          setStatus(
            `<strong>Dados válidos</strong>Esta é uma versão de demonstração: nenhuma informação foi enviada e nenhuma reserva foi feita.${summaryList(req)}`,
          );
          break;
        }
        default: {
          setStatus(
            `<strong>Quase lá</strong>Os canais oficiais de reserva estão sendo configurados neste site e nada foi enviado. Guarde os dados abaixo para consultar a equipe da hospedagem.${summaryList(req)}`,
          );
        }
      }
    });
  }
</script>
