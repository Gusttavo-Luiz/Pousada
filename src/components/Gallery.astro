---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import SectionHeading from './SectionHeading.astro';
import { galleryPhotos } from '../content/photos';
---

<section class="gallery section" id="galeria" aria-labelledby="gallery-title">
  <div class="container">
    <SectionHeading eyebrow="Galeria" id="gallery-title" align="split">
      Conheça cada <em>detalhe.</em>
      <Fragment slot="lead">Veja os ambientes e imagine sua próxima estadia.</Fragment>
    </SectionHeading>

    <ul class="gallery__grid">
      {
        galleryPhotos.map((photo, i) => (
          <li class:list={['gallery__item', { 'gallery__item--feature': i === 0, 'gallery__item--wide': i === 5 }]} data-reveal style={`--reveal-delay:${(i % 4) * 70}`}>
            <button type="button" class="gallery__button" data-lightbox-item="galeria" data-caption={photo.label} aria-label={`Ampliar foto ${i + 1} de ${galleryPhotos.length}: ${photo.label}`}>
              <Photo
                {...photo}
                sizes={i === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'}
                widths={i === 0 ? [600, 900, 1300] : [360, 600, 900]}
                zoomable
              />
              <span class="gallery__caption">
                <span>{photo.label}</span>
                <Icon name="expand" size={18} />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: clamp(150px, 6rem + 9vw, 270px);
    grid-auto-flow: dense;
    gap: clamp(0.5rem, 0.3rem + 0.8vw, 1rem);
  }

  .gallery__item--feature {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gallery__item--wide {
    grid-column: span 2;
  }

  .gallery__button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius);
    background: var(--beige);
    cursor: zoom-in;
  }

  .gallery__button :global(img),
  .gallery__button :global(picture),
  .gallery__button :global(.photo-placeholder) {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .gallery__button:hover :global(img),
  .gallery__button:hover :global(.photo-placeholder__art) {
    transform: scale(1.05);
  }

  .gallery__caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 2.5rem 1rem 0.9rem;
    background: linear-gradient(transparent, rgb(16 27 22 / 0.6));
    color: var(--warm-white);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: left;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .gallery__button:hover .gallery__caption,
  .gallery__button:focus-visible .gallery__caption {
    opacity: 1;
    transform: none;
  }

  /* Em telas de toque a legenda fica sempre visível. */
  @media (hover: none) {
    .gallery__caption {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(140px, 36vw, 240px);
    }

    .gallery__item--wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 860px) {
    .gallery__button :global(.photo-placeholder__hint),
    .gallery__item:not(.gallery__item--feature) .gallery__button :global(.photo-placeholder__file) {
      display: none;
    }
  }
</style>
