---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Landscape from './Landscape.astro';
import { getPhoto } from '../lib/photos';
import { featuredPhotos } from '../content/photos';

const photo = getPhoto(featuredPhotos.finalCta.file);
---

<section class:list={['final', { 'final--photo on-dark': photo }]} aria-labelledby="final-title">
  <div class="final__media" aria-hidden={photo ? undefined : 'true'}>
    {
      photo ? (
        <Picture
          src={photo}
          alt={featuredPhotos.finalCta.alt}
          widths={[640, 1024, 1600, 2200].filter((w) => w <= photo.width)}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="lazy"
        />
      ) : (
        <Landscape tone="dawn" />
      )
    }
  </div>
  <div class="container final__content">
    <p class="eyebrow" data-reveal>Planeje sua estadia</p>
    <h2 class="final__title" id="final-title" data-reveal style="--reveal-delay:100">
      Permita-se viver dias <em>mais leves.</em>
    </h2>
    <p class="final__text" data-reveal style="--reveal-delay:180">
      Lavras Novas espera por você. Venha descansar, descobrir novos caminhos e aproveitar a hospitalidade mineira.
    </p>
    <div data-reveal style="--reveal-delay:260">
      <a class:list={['btn', { 'btn--gold': photo }]} href="#reservas">
        Planejar minha estadia <Icon name="arrowRight" class="icon--move" />
      </a>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    display: grid;
    min-height: clamp(560px, 92vh, 860px);
    overflow: hidden;
    isolation: isolate;
    background: var(--beige);
  }

  .final__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .final__media :global(svg),
  .final__media :global(picture),
  .final__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .final--photo .final__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(16 27 22 / 0.55), rgb(16 27 22 / 0.15) 70%);
  }

  .final__content {
    display: grid;
    justify-items: center;
    align-content: start;
    padding-top: clamp(4.5rem, 3rem + 6vw, 8rem);
    padding-bottom: 14rem;
    text-align: center;
  }

  .final__title {
    max-width: 14ch;
    margin-top: 1.25rem;
    font-size: var(--step-5);
    font-weight: 400;
    line-height: 1.06;
    color: var(--forest);
  }

  .final__title em {
    color: var(--earth);
  }

  .final__text {
    max-width: 34rem;
    margin: 1.5rem 0 2.25rem;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .final--photo .final__title {
    color: var(--warm-white);
  }

  .final--photo .final__title em {
    color: var(--gold-light);
  }

  .final--photo .final__text {
    color: var(--on-dark-soft);
  }
</style>
