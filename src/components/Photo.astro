---
/**
 * Foto oficial de src/assets/fotos. Sem o arquivo, mostra uma moldura
 * elegante e facilmente substituível. Na demonstração/desenvolvimento a
 * moldura indica também o nome do arquivo esperado.
 */
import { Picture, getImage } from 'astro:assets';
import { getPhoto } from '../lib/photos';
import { showPending } from '../config/flags';

interface Props {
  file: string;
  alt: string;
  label?: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  /** Gera `data-full` com a versão grande (usada pelo visualizador). */
  zoomable?: boolean;
  tone?: 'light' | 'dark';
}

const {
  file,
  alt,
  label,
  widths = [480, 800, 1200],
  sizes = '(min-width: 1024px) 40vw, 100vw',
  priority = false,
  class: className,
  zoomable = false,
  tone = 'light',
} = Astro.props;

const image = getPhoto(file);
const usable = image ? widths.filter((w) => w <= image.width) : [];
if (image && usable.length === 0) usable.push(image.width);
const full = image && zoomable ? await getImage({ src: image, width: Math.min(image.width, 2000), format: 'webp' }) : null;
---

{
  image ? (
    <Picture
      src={image}
      alt={alt}
      widths={usable}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
      class:list={['photo', className]}
      data-full={full?.src}
    />
  ) : (
    <div class:list={['photo-placeholder', `photo-placeholder--${tone}`, className]} role="img" aria-label={`${alt} (fotografia oficial em breve)`}>
      <svg class="photo-placeholder__art" viewBox="0 0 400 260" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
        <circle cx="292" cy="78" r="26" fill="currentColor" opacity=".16" />
        <path d="M0 210 70 150l46 34 72-78 64 62 44-30 104 72v50H0Z" fill="currentColor" opacity=".1" />
        <path d="M0 236 92 186l58 28 86-54 74 46 90-30v84H0Z" fill="currentColor" opacity=".14" />
      </svg>
      <span class="photo-placeholder__label">{label ?? alt}</span>
      <span class="photo-placeholder__hint">Fotografia oficial em breve</span>
      {showPending && <code class="photo-placeholder__file">{file}</code>}
    </div>
  )
}

<style>
  .photo-placeholder {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    min-height: 180px;
    padding: 1.25rem;
    overflow: hidden;
    text-align: center;
    color: var(--olive);
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(252 250 246 / 0.7), transparent 60%),
      var(--beige);
  }

  .photo-placeholder--dark {
    color: var(--gold);
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(183 154 105 / 0.12), transparent 60%),
      var(--forest-deep);
  }

  .photo-placeholder__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .photo-placeholder__label {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    font-style: italic;
    color: var(--forest);
  }

  .photo-placeholder--dark .photo-placeholder__label {
    color: var(--beige);
  }

  .photo-placeholder__hint {
    position: relative;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .photo-placeholder--dark .photo-placeholder__hint {
    color: var(--on-dark-soft);
  }

  .photo-placeholder__file {
    position: relative;
    margin-top: 0.35rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgb(252 250 246 / 0.75);
    font-size: 0.6875rem;
    color: var(--earth);
  }

  .photo-placeholder--dark .photo-placeholder__file {
    background: rgb(20 33 27 / 0.6);
    color: var(--gold-light);
  }
</style>
