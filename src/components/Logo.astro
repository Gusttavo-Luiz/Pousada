---
/**
 * Marca tipográfica provisória "Luar de Minas · SUÍTES".
 * Substitua pelo logotipo oficial quando houver.
 */
interface Props {
  tone?: 'light' | 'dark';
  size?: 'sm' | 'md' | 'lg';
}

const { tone = 'dark', size = 'md' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`, `logo--${size}`]}>
  <svg class="logo__moon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1" opacity=".45"></circle>
    <path d="M20.5 7.5a9.5 9.5 0 1 0 4 12.2A8 8 0 0 1 20.5 7.5Z" fill="currentColor"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Luar de Minas</span>
    <span class="logo__sub">Suítes</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    line-height: 1;
    color: var(--forest);
    font-size: 1rem;
  }

  .logo--light {
    color: var(--warm-white);
  }

  .logo--sm {
    font-size: 0.875rem;
  }

  .logo--lg {
    font-size: 1.25rem;
  }

  .logo__moon {
    width: 2.1em;
    height: 2.1em;
    flex: none;
    color: var(--gold);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }

  .logo__name {
    font-family: var(--font-display);
    font-size: 1.38em;
    font-weight: 400;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .logo__sub {
    font-size: 0.62em;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    opacity: 0.8;
  }
</style>
