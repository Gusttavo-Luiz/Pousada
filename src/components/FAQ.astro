---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { faq } from '../content/faq';
---

<section class="faq section" id="perguntas" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <SectionHeading eyebrow="Perguntas frequentes" id="faq-title">
      Tudo o que você precisa <em>saber.</em>
      <Fragment slot="lead">Não encontrou o que procurava? Consulte a equipe ao enviar suas datas.</Fragment>
    </SectionHeading>

    <div class="faq__list">
      {
        faq.map((item, i) => (
          <details class="faq__item" name="faq" data-reveal style={`--reveal-delay:${Math.min(i, 5) * 40}`}>
            <summary>
              <span>{item.question}</span>
              <span class="faq__icon" aria-hidden="true">
                <Icon name="plus" size={18} />
              </span>
            </summary>
            <div class="faq__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 1rem + 5vw, 7rem);
    align-items: start;
  }

  .faq__grid > :global(.section-heading) {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .faq__list {
    border-top: 1px solid var(--line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.08rem, 1rem + 0.35vw, 1.28rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--forest);
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    color: var(--earth);
  }

  .faq__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      transform 0.4s var(--ease),
      background-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--forest);
    border-color: var(--forest);
    color: var(--warm-white);
  }

  .faq__answer {
    padding: 0 3.5rem 1.6rem 0;
    color: var(--ink-soft);
  }

  /* Abertura suave nos navegadores compatíveis. */
  @media (prefers-reduced-motion: no-preference) {
    .faq__item::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.45s var(--ease),
        content-visibility 0.45s allow-discrete;
    }

    .faq__item[open]::details-content {
      block-size: auto;
    }
  }

  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }

    .faq__grid > :global(.section-heading) {
      position: static;
    }

    .faq__answer {
      padding-right: 0;
    }
  }
</style>
