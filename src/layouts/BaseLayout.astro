---
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import playfairLatin from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, mapLinks } from '../config/site';
import { demoMode } from '../config/flags';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Página inicial: cabeçalho transparente sobre a primeira dobra. */
  home?: boolean;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, home = false, jsonLd = [], noindex = false } = Astro.props;
const origin = Astro.site;
const canonical = origin ? new URL(Astro.url.pathname, origin).href : undefined;
const ogImage = origin ? new URL(withBase('/og-image.jpg'), origin).href : withBase('/og-image.jpg');

/** Dados estruturados apenas com informações verificadas (sem notas autodeclaradas). */
const lodging = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description:
    'Hospedagem com suítes em Lavras Novas, Minas Gerais, com café da manhã, Wi-Fi gratuito, banheiro privativo e check-in e check-out privativos.',
  ...(origin && { url: new URL(withBase('/'), origin).href, '@id': `${new URL(withBase('/'), origin).href}#hospedagem` }),
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.district,
    addressRegion: site.address.state,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  hasMap: mapLinks.view,
  ...(site.contact.phoneDisplay && { telephone: site.contact.phoneDisplay }),
  ...(site.contact.email && { email: site.contact.email }),
  petsAllowed: 'Mediante solicitação; pode haver cobrança adicional.',
  amenityFeature: [
    { name: 'Café da manhã', value: true },
    { name: 'Wi-Fi gratuito', value: true },
    { name: 'Banheiro privativo', value: true },
    { name: 'Check-in e check-out privativos', value: true },
    { name: 'Estacionamento', value: false },
  ].map((f) => ({ '@type': 'LocationFeatureSpecification', ...f })),
  sameAs: [site.social.instagram, site.social.facebook].filter(Boolean),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex || demoMode ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#263d32" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="BR-MG" />
    <meta name="geo.placename" content="Lavras Novas" />

    <link rel="preload" href={playfairLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    {origin && <link rel="sitemap" href={withBase('/sitemap.xml')} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Luar de Minas Suítes — hospedagem em Lavras Novas, Minas Gerais" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js')</script>
    {[lodging, ...jsonLd].map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header solid={!home} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer external={!home} />
    <slot name="after" />

    <script>
      const blocks = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        blocks.forEach((block) => io.observe(block));
      } else {
        blocks.forEach((block) => block.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }

</style>
